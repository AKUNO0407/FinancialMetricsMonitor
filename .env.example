# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file — it is already excluded via .gitignore.

# --- PostgreSQL (Supabase / Neon free tier) ---
DATABASE_URL=postgresql://user:PSWD@host/database
# Some providers (Supabase) require sslmode=require, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- SMTP (failure alert emails, reused from news_monitor.py pattern) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password   # use a Gmail "App Password", not your real login password
ALERT_EMAIL_TO=you@example.com

# --- LLM API (optional, for news summarization) ---
LLM_PROVIDER=deepseek   # one of: claude | openai | ollama | deepseek
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY= your_deepseek_api_key

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_HOST=

# --- Misc ---
TIMEZONE=America/Toronto
ETL_LOOKBACK_DAYS=2



PRICE_LOOKBACK_DAYS=60
PRICE_REFRESH_DAYS=5

EARNINGS_FUTURE_COUNT=2
EARNINGS_HISTORY_LIMIT=8